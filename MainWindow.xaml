<Window x:Class="TwitchChatAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TwitchChatAgent" Title="APEX ChatD" Icon="Assets/APEXChatd.ico" Width="960" Height="879.75" MinWidth="850" MinHeight="620"
        Background="{DynamicResource FluentBackdrop}" Foreground="{DynamicResource FluentText}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Window.Resources>
  <Style x:Key="SettingsSection" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource FluentPanelStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="14"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="StatusWhenSet" TargetType="TextBlock">
    <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="SettingsSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
    <Setter Property="FontSize" Value="15"/>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,16,6"/><Setter Property="MinHeight" Value="48"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="Foreground" Value="{DynamicResource FluentSecondary}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="TabItem">
     <Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5" BorderBrush="Transparent" BorderThickness="1">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
       <ContentPresenter x:Name="TabHeader" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Left" VerticalAlignment="Center"/>
       <Border x:Name="SelectionIndicator" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource FluentAccent}" HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource FluentTabHover}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource FluentTabSelected}"/><Setter Property="Foreground" Value="{DynamicResource FluentText}"/><Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/><Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource FluentAccent}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Foreground" Value="{DynamicResource FluentText}"/>
   <Setter Property="Background" Value="{DynamicResource FluentPanel}"/><Setter Property="BorderBrush" Value="{DynamicResource FluentPanelStroke}"/>
   <Setter Property="TabStripPlacement" Value="Left"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="TabControl">
     <Grid KeyboardNavigation.TabNavigation="Local">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
       <StackPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" KeyboardNavigation.DirectionalNavigation="Cycle"/>
      </ScrollViewer>
      <Border Grid.Column="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
       <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource FluentDivider}" BorderThickness="0,0,0,1" Padding="28,24,28,20">
         <TextBlock Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}" FontSize="22" FontWeight="SemiBold"/>
        </Border>
        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0" KeyboardNavigation.TabIndex="2"/>
       </DockPanel>
      </Border>
     </Grid>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  </Window.Resources>
  <DockPanel Margin="24">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <ComboBox x:Name="HeaderLanguageChoice" DockPanel.Dock="Right" Width="88" Height="32" MinHeight="32"
                VerticalAlignment="Top" Margin="16,0,0,0" FontSize="12" FontWeight="SemiBold"
                ToolTip="{local:Ui InterfaceLanguage}" AutomationProperties.Name="{local:Ui InterfaceLanguage}"
                DisplayMemberPath="ShortName"/>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Image Source="Assets/APEXChatd.png" Width="32" Height="32" Margin="0,0,8,0"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="APEX ChatD" FontSize="27" FontWeight="SemiBold"/>
        </StackPanel>
        <TextBlock Text="{local:Ui ChannelChatOnYourDesktopInOBSAndInYourHeadphones}" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
      <Button Content="{local:Ui TestMessage}" Click="TestClicked"/>
      <Button Content="{local:Ui ClearDisplayedMessages}" Click="ClearDisplayedClicked"/>
    </StackPanel>
    <TabControl x:Name="MainTabs">
      <TabItem Header="Twitch" Tag="&#xE8BD;">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
          <TextBlock Text="{local:Ui ConnectYourChannel}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>
          <WrapPanel>
            <Button x:Name="ConnectButton" Content="{local:Ui ConnectTwitch}" Style="{StaticResource AccentButton}" Click="ConnectClicked"/>
            <Button x:Name="ReconnectButton" Content="{local:Ui UpdateTwitchPermissions}" Visibility="Collapsed" Click="ReconnectClicked"/>
            <Button x:Name="DisconnectButton" Content="{local:Ui DisconnectCancel}" Click="DisconnectClicked"/>
          </WrapPanel>
          <TextBlock x:Name="TwitchStatus" Margin="0,14,0,0" Text="{local:Ui TwitchIsDisconnected}" TextWrapping="Wrap"/>
          <TextBlock Text="{local:Ui RecentMessages}" Margin="0,16,0,8" FontWeight="SemiBold"/>
          <TextBlock x:Name="ModerationStatus" Margin="0,0,0,8" TextWrapping="Wrap"/>
          <ListBox x:Name="Recent" Height="290" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"
                             local:ChatText.Message="{Binding Message, Mode=OneWay}"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{local:Ui Delete}" IsEnabled="{Binding CanDelete}" ToolTip="{Binding DeleteReason}"
                            ToolTipService.ShowOnDisabled="True" Click="DeleteMessageClicked"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{local:Ui Overlay}" Tag="&#xE7F4;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,24,28,8">
            <CheckBox x:Name="OverlayEnabled" Content="{local:Ui ShowChatAboveOtherWindows}" Margin="0,0,0,12"/>
            <CheckBox x:Name="OverlayLiveOnly" Content="{local:Ui ShowTheOverlayOnlyWhileLive}" Margin="0,0,0,12"/>
            <ContentControl x:Name="OverlayTheme"/>
            <WrapPanel Margin="0,14,0,0">
              <Button x:Name="MoveOverlay" Content="{local:Ui PositionOverlay}" Click="MoveOverlayClicked"/>
            </WrapPanel>
            <TextBlock x:Name="LiveStatus" Style="{StaticResource StatusWhenSet}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="OverlayStatus" Style="{StaticResource StatusWhenSet}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="OBS" Tag="&#xE7F8;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,24">
            <Border Style="{StaticResource SettingsSection}">
              <StackPanel>
                <TextBlock Text="{local:Ui ObsIntegration}" Style="{StaticResource SettingsSectionTitle}"/>
                <CheckBox x:Name="ObsEnabled" Content="{local:Ui RunTheLocalOBSServer}" Margin="0,0,0,10"/>
                <DockPanel>
                  <Button x:Name="PreviewObs" DockPanel.Dock="Right" Content="&#xE774;" Click="PreviewObsClicked"
                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="42" Padding="0" Margin="8,0,0,0"
                          ToolTip="{local:Ui PreviewInBrowser}" AutomationProperties.Name="{local:Ui PreviewInBrowser}"/>
                  <Button DockPanel.Dock="Right" Content="&#xE8C8;" Click="CopyObsClicked"
                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="42" Padding="0" Margin="8,0,0,0"
                          ToolTip="{local:Ui CopyLink}" AutomationProperties.Name="{local:Ui CopyLink}"/>
                  <TextBox x:Name="ObsLink" IsReadOnly="True" AutomationProperties.Name="{local:Ui ObsBrowserSourceUrl}"/>
                </DockPanel>
                <TextBlock x:Name="ObsStatus" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <ContentControl x:Name="ObsTheme" HorizontalContentAlignment="Stretch"/>
            <Border Style="{StaticResource SettingsSection}">
              <StackPanel>
                <TextBlock Text="{local:Ui ObsPostProcessing}" Style="{StaticResource SettingsSectionTitle}"/>
                <ContentControl x:Name="ObsEffects" HorizontalContentAlignment="Stretch"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{local:Ui Speech}" Tag="&#xE767;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,24">
            <CheckBox x:Name="SpeechEnabled" Content="{local:Ui ReadAllNewMessagesAloud}" Margin="0,0,0,12"/>
            <Border x:Name="MissingSpeechVoiceWarning" Visibility="Collapsed" Margin="0,0,0,12"
                    Background="{DynamicResource FluentBackdrop}" BorderBrush="{DynamicResource FluentPanelStroke}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
              <StackPanel>
                <TextBlock Text="{local:Ui MissingSpeechVoices}" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,8,0,0">
                  <Button x:Name="AddRandomEdgeVoiceButton" Content="{local:Ui AddRandomEdgeVoice}" Click="AddRandomEdgeVoiceClicked" Visibility="Collapsed"/>
                  <Button Content="{local:Ui OpenVoices}" Click="OpenVoicesClicked" Margin="0"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <CheckBox x:Name="ReadName" Content="{local:Ui ReadTheUsernameBeforeTheMessage}" Margin="0,0,0,10"/>
            <StackPanel Margin="16,0,0,12">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, ElementName=ReadName}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="{local:Ui SpeechAfterUsername}" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="ReadNamePhrase" AutomationProperties.Name="{local:Ui SpeechAfterUsername}"/>
              <TextBlock Text="{local:Ui SpeechAfterUsernameHint}" Foreground="{DynamicResource FluentSecondary}"
                         Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <CheckBox x:Name="FilterSpeechByPrefix" Content="{local:Ui FilterSpeechByPrefix}" Margin="0,0,0,10"/>
            <StackPanel Margin="16,0,0,12">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, ElementName=FilterSpeechByPrefix}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="{local:Ui SpeechPrefix}" Style="{StaticResource FieldLabel}"/>
              <DockPanel>
                <CheckBox x:Name="InvertSpeechPrefix" DockPanel.Dock="Right" Content="{local:Ui InvertSpeechPrefix}"
                          ToolTip="{local:Ui InvertSpeechPrefixHint}" AutomationProperties.Name="{local:Ui InvertSpeechPrefixHint}"
                          VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox x:Name="SpeechPrefix" AutomationProperties.Name="{local:Ui SpeechPrefix}"/>
              </DockPanel>
              <TextBlock Text="{local:Ui SpeechPrefixHint}" Foreground="{DynamicResource FluentSecondary}"
                         Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <CheckBox x:Name="SkipSpeechEmotes" Content="{local:Ui SkipSpeechEmotes}" Margin="0,0,0,12"/>
            <CheckBox x:Name="RetrySpeech" Content="{local:Ui RetryFailedMessagesIndefinitely}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource SettingsSection}" Padding="14,12" Margin="0,0,0,8"
                    Background="{DynamicResource FluentBackdrop}">
              <StackPanel>
                <TextBlock Text="{local:Ui AudioOutputDevice}" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="{local:Ui RefreshAudioDevices}" Click="RefreshAudioDevicesClicked" Margin="8,0,0,0"/>
                  <ComboBox x:Name="AudioDeviceChoice" DisplayMemberPath="Name" SelectedValuePath="Id"
                            AutomationProperties.Name="{local:Ui AudioOutputDevice}"/>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                  <TextBlock DockPanel.Dock="Left" Text="{local:Ui Volume}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <Border DockPanel.Dock="Right" Background="{DynamicResource FluentSurface}" CornerRadius="5"
                          Padding="6,3" MinWidth="49" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Value, ElementName=Volume, StringFormat={}{0:0}%}"
                               TextAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                  </Border>
                  <Slider x:Name="Volume" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                          IsMoveToPointEnabled="True" SmallChange="1" LargeChange="5" AutomationProperties.Name="{local:Ui Volume}"/>
                </DockPanel>
                <TextBlock x:Name="AudioDeviceStatus" Style="{StaticResource StatusWhenSet}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="SpeechSettingsStatus" Style="{StaticResource StatusWhenSet}" Margin="0,6,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource FluentPanelStroke}" BorderThickness="1" CornerRadius="8"
                    Padding="12">
              <StackPanel>
                <TextBlock Text="{local:Ui SpeechQueue}" Style="{StaticResource FieldLabel}"/>
                <WrapPanel>
                  <WrapPanel.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                  </WrapPanel.Resources>
                  <Button x:Name="PauseQueueButton" Click="PauseClicked" Margin="0,0,8,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="PauseQueueIcon" Text="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0"/>
                      <TextBlock x:Name="PauseQueueLabel" Text="{local:Ui Pause}"/>
                    </StackPanel>
                  </Button>
                  <Button Click="SkipClicked" Margin="0,0,8,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE101;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0"/>
                      <TextBlock Text="{local:Ui Skip}"/>
                    </StackPanel>
                  </Button>
                  <Button Click="ClearClicked" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0"/>
                      <TextBlock Text="{local:Ui ClearQueue}"/>
                    </StackPanel>
                  </Button>
                </WrapPanel>
                <TextBlock x:Name="SpeechStatus" Margin="0,6,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="VoicesTab" Header="{local:Ui Voices}" Tag="&#xE720;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,24">
            <ListBox x:Name="VoiceProfilesList" DisplayMemberPath="Label" MinHeight="40" MaxHeight="180"
                     SelectionChanged="VoiceProfileSelected" MouseDoubleClick="VoiceProfileDoubleClicked"
                     AutomationProperties.Name="{local:Ui AvailableSpeechVoices}"/>
            <TextBlock x:Name="VoiceProfilesHint" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,10,0,0">
              <Button Content="{local:Ui AddSpeechVoice}" Click="AddVoiceProfileClicked" Margin="0,0,8,4"/>
              <Button x:Name="EditVoiceProfileButton" Content="{local:Ui EditSpeechVoice}" Click="EditVoiceProfileClicked"
                      IsEnabled="False" Margin="0,0,8,4"/>
              <Button x:Name="MakePrimaryVoiceButton" Content="{local:Ui MakePrimarySpeechVoice}" Click="MakePrimaryVoiceClicked"
                      IsEnabled="False" Margin="0,0,8,4"/>
              <Button x:Name="RemoveVoiceProfile" Content="{local:Ui Delete}" Click="RemoveVoiceProfileClicked"
                      IsEnabled="False" Margin="0,0,0,4"/>
            </WrapPanel>
            <CheckBox x:Name="RandomSpeechVoice" Content="{local:Ui RandomSpeechVoice}" Margin="0,16,0,0"/>
            <CheckBox x:Name="PinSpeechVoice" Content="{local:Ui PinSpeechVoice}" Margin="16,6,0,0" Visibility="Collapsed"/>
            <Button x:Name="ResetPinnedVoices" Content="{local:Ui ResetPinnedVoices}" Click="ResetPinnedVoicesClicked"
                    Margin="16,6,0,0" HorizontalAlignment="Left" Visibility="Collapsed"/>
            <TextBlock Text="{Binding Text, ElementName=SpeechSettingsStatus}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{local:Ui Controls}" Tag="&#xE765;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
          <TextBlock Text="{local:Ui Hotkeys}" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{local:Ui QueueHotkeyHint}" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" Margin="0,0,0,14"/>
          <TextBlock Text="{local:Ui PauseOrResume}" Margin="0,0,0,8"/>
          <TextBox x:Name="PauseShortcut" Tag="Pause" IsReadOnly="True" PreviewKeyDown="ShortcutKeyDown"
                   PreviewMouseDown="ShortcutMouseDown" GotKeyboardFocus="ShortcutFocused" LostKeyboardFocus="ShortcutUnfocused"/>
          <TextBlock Text="{local:Ui SkipMessage}" Margin="0,12,0,8"/>
          <TextBox x:Name="SkipShortcut" Tag="Skip" IsReadOnly="True" PreviewKeyDown="ShortcutKeyDown"
                   PreviewMouseDown="ShortcutMouseDown" GotKeyboardFocus="ShortcutFocused" LostKeyboardFocus="ShortcutUnfocused"/>
          <TextBlock Text="{local:Ui ClearQueue}" Margin="0,12,0,8"/>
          <TextBox x:Name="ClearShortcut" Tag="Clear" IsReadOnly="True" PreviewKeyDown="ShortcutKeyDown"
                   PreviewMouseDown="ShortcutMouseDown" GotKeyboardFocus="ShortcutFocused" LostKeyboardFocus="ShortcutUnfocused"/>
          <TextBlock Text="{local:Ui ClearDisplayedMessages}" Margin="0,12,0,8"/>
          <TextBox x:Name="ClearDisplayedShortcut" Tag="ClearDisplayed" IsReadOnly="True" PreviewKeyDown="ShortcutKeyDown"
                   PreviewMouseDown="ShortcutMouseDown" GotKeyboardFocus="ShortcutFocused" LostKeyboardFocus="ShortcutUnfocused"
                   AutomationProperties.Name="{local:Ui ClearDisplayedMessages}"/>
          <StackPanel x:Name="PluginShortcutList"/>
          <TextBlock x:Name="HotkeyStatus" TextWrapping="Wrap" Focusable="True" Margin="0,12,0,0"/>
        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{local:Ui Application}" Tag="&#xE713;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,24">
            <StackPanel Margin="0,0,0,18">
              <TextBlock Text="{local:Ui Startup}" Style="{StaticResource SettingsSectionTitle}"/>
              <CheckBox x:Name="StartWithWindows" Content="{local:Ui StartWithWindows}"/>
              <CheckBox x:Name="StartMinimized" Content="{local:Ui StartMinimized}" Margin="0,8,0,0"/>
              <CheckBox x:Name="MinimizeToTray" Content="{local:Ui MinimizeToNotificationArea}" Margin="0,8,0,0"/>
              <TextBlock x:Name="StartupStatus" TextWrapping="Wrap"/>
            </StackPanel>
            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{local:Ui AppTheme}" Style="{StaticResource SettingsSectionTitle}"/>
                <ComboBox x:Name="AppThemeChoice" AutomationProperties.Name="{local:Ui AppTheme}">
                  <ComboBoxItem Content="{local:Ui UseWindowsTheme}"/>
                  <ComboBoxItem Content="{local:Ui Light}"/>
                  <ComboBoxItem Content="{local:Ui Dark}"/>
                </ComboBox>
                <TextBlock x:Name="ThemeStatus" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{local:Ui InterfaceLanguage}" Style="{StaticResource SettingsSectionTitle}"/>
                <ComboBox x:Name="LanguageChoice" AutomationProperties.Name="{local:Ui InterfaceLanguage}" DisplayMemberPath="Name"/>
                <TextBlock x:Name="LanguageStatus" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource SettingsSection}">
              <TextBlock x:Name="VersionLabel" Foreground="{DynamicResource FluentSecondary}"/>
            </Border>
            <StackPanel Margin="0,0,0,18">
              <Button Content="{local:Ui ResetAllSettings}" Click="ResetSettingsClicked" HorizontalAlignment="Left" Margin="0"/>
              <TextBlock x:Name="AppStatus" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Style="{StaticResource SettingsSection}">
              <StackPanel>
                <TextBlock Text="{local:Ui AboutAuthor}" Style="{StaticResource SettingsSectionTitle}"/>
                <TextBlock Text="{local:Ui CodexCredit}" TextWrapping="Wrap"/>
                <TextBlock Margin="0,6,0,0">
                  <Hyperlink NavigateUri="https://github.com/Tor-del" RequestNavigate="AuthorGitHubRequested"
                             Foreground="{DynamicResource FluentAccent}">GitHub</Hyperlink>
                </TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="PluginsTab" Tag="&#xE74C;">
        <DockPanel Margin="28,20,28,24">
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource FluentDivider}" BorderThickness="0,0,0,1"
                  Margin="0,0,0,16" Padding="0,0,0,12">
            <StackPanel>
              <WrapPanel>
                <Button x:Name="AddPluginButton" Click="AddPluginClicked" Style="{StaticResource AccentButton}" IsEnabled="False" Margin="0,0,8,8"/>
                <Button x:Name="OpenPluginFolderButton" Click="OpenPluginFolderClicked" Margin="0,0,8,8"/>
                <Button x:Name="RestartForPluginsButton" Click="RestartForPluginsClicked" Margin="0,0,0,8"/>
              </WrapPanel>
              <TextBlock x:Name="PluginStatus" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4"
                         Foreground="{DynamicResource FluentAccent}" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PluginList"/>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
