<Window x:Class="TwitchChatAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TwitchChatAgent" Title="APEX Chatd" Icon="Assets/APEXChatd.ico" Width="960" Height="862.5" MinWidth="850" MinHeight="620"
        Background="{DynamicResource FluentBackdrop}" Foreground="{DynamicResource FluentText}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Window.Resources>
  <Style TargetType="TabItem">
   <Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,16,6"/><Setter Property="MinHeight" Value="48"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="Foreground" Value="{DynamicResource FluentSecondary}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="TabItem">
     <Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5" BorderBrush="Transparent" BorderThickness="1">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
       <ContentPresenter x:Name="TabHeader" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Left" VerticalAlignment="Center"/>
       <Border x:Name="SelectionIndicator" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource FluentAccent}" HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource FluentTabHover}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource FluentTabSelected}"/><Setter Property="Foreground" Value="{DynamicResource FluentText}"/><Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/><Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource FluentAccent}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Foreground" Value="{DynamicResource FluentText}"/>
   <Setter Property="Background" Value="{DynamicResource FluentPanel}"/><Setter Property="BorderBrush" Value="{DynamicResource FluentPanelStroke}"/>
   <Setter Property="TabStripPlacement" Value="Left"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="TabControl">
     <Grid KeyboardNavigation.TabNavigation="Local">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
       <StackPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" KeyboardNavigation.DirectionalNavigation="Cycle"/>
      </ScrollViewer>
      <Border Grid.Column="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
       <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource FluentDivider}" BorderThickness="0,0,0,1" Padding="28,24,28,20">
         <TextBlock Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}" FontSize="22" FontWeight="SemiBold"/>
        </Border>
        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0" KeyboardNavigation.TabIndex="2"/>
       </DockPanel>
      </Border>
     </Grid>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  </Window.Resources>
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal"><Image Source="Assets/APEXChatd.ico" Width="32" Height="32" Margin="0,0,8,0"/><TextBlock Text="APEX Chatd" FontSize="27" FontWeight="SemiBold"/></StackPanel>
      <TextBlock Text="{local:Ui ChannelChatOnYourDesktopInOBSAndInYourHeadphones}" Foreground="{DynamicResource FluentSecondary}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
      <Button Content="{local:Ui TestMessage}" Click="TestClicked"/>
      <Button Content="{local:Ui ClearDisplayedMessages}" Click="ClearDisplayedClicked"/>
    </StackPanel>
    <TabControl>
      <TabItem Header="Twitch" Tag="&#xE8BD;">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
          <TextBlock Text="{local:Ui ConnectYourChannel}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>
          <WrapPanel>
            <Button x:Name="ConnectButton" Content="{local:Ui ConnectTwitch}" Style="{StaticResource AccentButton}" Click="ConnectClicked"/>
            <Button x:Name="ReconnectButton" Content="{local:Ui UpdateTwitchPermissions}" Visibility="Collapsed" Click="ReconnectClicked"/>
            <Button x:Name="DisconnectButton" Content="{local:Ui DisconnectCancel}" Click="DisconnectClicked"/>
          </WrapPanel>
          <TextBlock x:Name="TwitchStatus" Margin="0,14,0,0" Text="{local:Ui TwitchIsDisconnected}" TextWrapping="Wrap"/>
          <TextBlock Text="{local:Ui RecentMessages}" Margin="0,16,0,8" FontWeight="SemiBold"/>
          <TextBlock x:Name="ModerationStatus" Margin="0,0,0,8" TextWrapping="Wrap"/>
          <ListBox x:Name="Recent" Height="290" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"
                             local:ChatText.Message="{Binding Message, Mode=OneWay}"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{local:Ui Delete}" IsEnabled="{Binding CanDelete}" ToolTip="{Binding DeleteReason}"
                            ToolTipService.ShowOnDisabled="True" Click="DeleteMessageClicked"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{local:Ui Overlay}" Tag="&#xE7F4;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,24">
            <CheckBox x:Name="OverlayEnabled" Content="{local:Ui ShowChatAboveOtherWindows}" Margin="0,0,0,12"/>
            <CheckBox x:Name="OverlayLiveOnly" Content="{local:Ui ShowTheOverlayOnlyWhileLive}" Margin="0,0,0,12"/>
            <ContentControl x:Name="OverlayTheme"/>
            <WrapPanel Margin="0,14,0,0">
              <Button x:Name="MoveOverlay" Content="{local:Ui PositionOverlay}" Click="MoveOverlayClicked"/>
            </WrapPanel>
            <TextBlock x:Name="LiveStatus" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="OverlayStatus" Margin="0,12,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="OBS" Tag="&#xE7F8;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,24">
            <CheckBox x:Name="ObsEnabled" Content="{local:Ui RunTheLocalOBSServer}" Margin="0,0,0,12"/>
            <ContentControl x:Name="ObsTheme"/>
            <ContentControl x:Name="ObsEffects"/>
            <DockPanel Margin="0,14,0,0">
              <Button DockPanel.Dock="Right" Content="{local:Ui CopyLink}" Click="CopyObsClicked" Margin="8,0,0,0"/>
              <TextBox x:Name="ObsLink" IsReadOnly="True"/>
            </DockPanel>
            <Button x:Name="PreviewObs" Content="{local:Ui PreviewInBrowser}" Click="PreviewObsClicked"
                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
            <TextBlock x:Name="ObsStatus" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{local:Ui Speech}" Tag="&#xE767;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,24">
            <CheckBox x:Name="SpeechEnabled" Content="{local:Ui ReadAllNewMessagesAloud}" Margin="0,0,0,12"/>
            <CheckBox x:Name="ReadName" Content="{local:Ui ReadTheUsernameBeforeTheMessage}" Margin="0,0,0,12"/>
            <CheckBox x:Name="RetrySpeech" Content="{local:Ui RetryFailedMessagesIndefinitely}" Margin="0,0,0,12"/>
            <TextBlock Text="{local:Ui Provider}" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="Engine">
              <ComboBoxItem Content="{local:Ui WindowsVoice}"/>
              <ComboBoxItem Content="Edge TTS"/>
              <ComboBoxItem Content="{local:Ui CompatibleTtsProvider}"/>
            </ComboBox>
            <StackPanel x:Name="WindowsVoiceOptions">
              <TextBlock Text="{local:Ui WindowsVoice}" Margin="0,10,0,4"/>
              <ComboBox x:Name="WindowsVoice" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
            </StackPanel>
            <StackPanel x:Name="EdgeVoiceOptions" Visibility="Collapsed">
              <TextBlock Text="{local:Ui EdgeTTSLanguage}" Margin="0,10,0,4"/>
              <ComboBox x:Name="EdgeLanguage" DisplayMemberPath="Name" SelectedValuePath="Code"/>
              <TextBlock Text="{local:Ui EdgeTTSVoice}" Margin="0,10,0,4"/>
              <ComboBox x:Name="EdgeVoice" DisplayMemberPath="FriendlyName" SelectedValuePath="ShortName"/>
              <CheckBox x:Name="RandomEdgeVoice" Content="{local:Ui RandomEdgeVoice}" Margin="0,8,0,0"/>
              <CheckBox x:Name="RandomEdgeVoiceInLanguage" Content="{local:Ui RandomEdgeVoiceInLanguage}"
                        Margin="16,6,0,0" Visibility="Collapsed"/>
              <CheckBox x:Name="PinRandomEdgeVoice" Content="{local:Ui PinRandomEdgeVoice}"
                        Margin="16,6,0,0" Visibility="Collapsed"/>
              <Button x:Name="ResetPinnedVoices" Content="{local:Ui ResetPinnedVoices}" Click="ResetPinnedVoicesClicked"
                      Margin="16,6,0,0" HorizontalAlignment="Left" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel x:Name="CompatibleTtsOptions" Visibility="Collapsed">
              <TextBlock Text="{local:Ui TtsEndpoint}" Margin="0,10,0,4"/>
              <TextBox x:Name="TtsEndpoint"/>
              <TextBlock Text="{local:Ui TtsModel}" Margin="0,10,0,4"/>
              <TextBox x:Name="TtsModel"/>
              <TextBlock Text="{local:Ui TtsVoice}" Margin="0,10,0,4"/>
              <TextBox x:Name="TtsVoice"/>
              <TextBlock Text="{local:Ui TtsApiKey}" Margin="0,10,0,4"/>
              <PasswordBox x:Name="TtsApiKey"/>
              <TextBlock Text="{local:Ui TtsFormat}" Margin="0,10,0,4"/>
              <ComboBox x:Name="TtsFormat">
                <ComboBoxItem Content="MP3"/>
                <ComboBoxItem Content="WAV"/>
              </ComboBox>
            </StackPanel>
            <TextBlock Text="{local:Ui AudioOutputDevice}" Margin="0,12,0,4"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{local:Ui RefreshAudioDevices}" Click="RefreshAudioDevicesClicked" Margin="8,0,0,0"/>
              <ComboBox x:Name="AudioDeviceChoice" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            </DockPanel>
            <TextBlock x:Name="AudioDeviceStatus" TextWrapping="Wrap"/>
            <TextBlock x:Name="SpeechSettingsStatus" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <DockPanel Margin="0,14,0,4">
              <TextBlock DockPanel.Dock="Left" Text="{local:Ui Speed}" Width="100"/>
              <TextBlock DockPanel.Dock="Right" Width="60" TextAlignment="Right"
                         Text="{Binding Value, ElementName=Rate, StringFormat={}{0:+0;-0;0}%}"/>
              <Slider x:Name="Rate" Minimum="-50" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                      IsMoveToPointEnabled="True" SmallChange="1" LargeChange="5" AutomationProperties.Name="{local:Ui Speed}"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,4">
              <TextBlock DockPanel.Dock="Left" Text="{local:Ui Volume}" Width="100"/>
              <TextBlock DockPanel.Dock="Right" Width="60" TextAlignment="Right"
                         Text="{Binding Value, ElementName=Volume, StringFormat={}{0:0}%}"/>
              <Slider x:Name="Volume" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                      IsMoveToPointEnabled="True" SmallChange="1" LargeChange="5" AutomationProperties.Name="{local:Ui Volume}"/>
            </DockPanel>
            <TextBlock Text="{local:Ui SpeechEffect}" Margin="0,12,0,4"/>
            <ComboBox x:Name="SpeechEffectChoice" AutomationProperties.Name="{local:Ui SpeechEffect}">
              <ComboBoxItem Content="{local:Ui SpeechEffectNone}"/>
              <ComboBoxItem Content="{local:Ui SpeechEffectUnderwater}"/>
              <ComboBoxItem Content="{local:Ui SpeechEffectRadio}"/>
              <ComboBoxItem Content="Voice Mail"/>
              <ComboBoxItem Content="Reciver"/>
              <ComboBoxItem Content="Underwater Shallow"/>
              <ComboBoxItem Content="Underwater Deeper"/>
              <ComboBoxItem Content="Club Downstairs"/>
              <ComboBoxItem Content="Only the Twitter"/>
            </ComboBox>
            <DockPanel x:Name="SpeechEffectControls" Margin="0,8,0,4">
              <TextBlock DockPanel.Dock="Left" Text="{local:Ui SpeechEffectIntensity}" MinWidth="100" Margin="0,0,8,0"/>
              <TextBlock DockPanel.Dock="Right" Width="60" TextAlignment="Right"
                         Text="{Binding Value, ElementName=SpeechEffectIntensity, StringFormat={}{0:0}%}"/>
              <Slider x:Name="SpeechEffectIntensity" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                      IsMoveToPointEnabled="True" SmallChange="1" LargeChange="5"
                      AutomationProperties.Name="{local:Ui SpeechEffectIntensity}"/>
            </DockPanel>
            <CheckBox x:Name="SpeechRadioNoise" Content="{local:Ui SpeechRadioNoise}" Margin="0,4,0,0"/>
            <DockPanel Margin="0,10,0,4">
              <TextBlock DockPanel.Dock="Left" Text="{local:Ui SpeechPitch}" Width="150" VerticalAlignment="Center"/>
              <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding Value, ElementName=SpeechPitch, StringFormat={}{0:+0;-0;0}}"/>
              <Slider x:Name="SpeechPitch" Minimum="-12" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                      IsMoveToPointEnabled="True" AutomationProperties.Name="{local:Ui SpeechPitch}"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,4">
              <TextBlock DockPanel.Dock="Left" Text="{local:Ui SpeechFormant}" Width="150" VerticalAlignment="Center"/>
              <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding Value, ElementName=SpeechFormant, StringFormat={}{0:+0;-0;0}}"/>
              <Slider x:Name="SpeechFormant" Minimum="-6" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True"
                      IsMoveToPointEnabled="True" AutomationProperties.Name="{local:Ui SpeechFormant}"/>
            </DockPanel>
            <Border BorderBrush="{DynamicResource FluentPanelStroke}" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="{local:Ui SpeechQueue}" Style="{StaticResource FieldLabel}"/>
                <WrapPanel>
                  <WrapPanel.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                  </WrapPanel.Resources>
                  <Button x:Name="PauseQueueButton" Click="PauseClicked" Margin="0,0,8,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="PauseQueueIcon" Text="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0"/>
                      <TextBlock x:Name="PauseQueueLabel" Text="{local:Ui Pause}"/>
                    </StackPanel>
                  </Button>
                  <Button Click="SkipClicked" Margin="0,0,8,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE101;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0"/>
                      <TextBlock Text="{local:Ui Skip}"/>
                    </StackPanel>
                  </Button>
                  <Button Click="ClearClicked" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0"/>
                      <TextBlock Text="{local:Ui ClearQueue}"/>
                    </StackPanel>
                  </Button>
                </WrapPanel>
                <TextBlock x:Name="SpeechStatus" Margin="0,6,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{local:Ui Controls}" Tag="&#xE765;">
        <StackPanel Margin="28,24">
          <TextBlock Text="{local:Ui QueueHotkeys}" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{local:Ui QueueHotkeyHint}" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" Margin="0,0,0,14"/>
          <TextBlock Text="{local:Ui PauseOrResume}" Margin="0,0,0,8"/>
          <TextBox x:Name="PauseShortcut" Tag="Pause" IsReadOnly="True" PreviewKeyDown="ShortcutKeyDown"
                   PreviewMouseDown="ShortcutMouseDown" GotKeyboardFocus="ShortcutFocused" LostKeyboardFocus="ShortcutUnfocused"/>
          <TextBlock Text="{local:Ui SkipMessage}" Margin="0,12,0,8"/>
          <TextBox x:Name="SkipShortcut" Tag="Skip" IsReadOnly="True" PreviewKeyDown="ShortcutKeyDown"
                   PreviewMouseDown="ShortcutMouseDown" GotKeyboardFocus="ShortcutFocused" LostKeyboardFocus="ShortcutUnfocused"/>
          <TextBlock Text="{local:Ui ClearQueue}" Margin="0,12,0,8"/>
          <TextBox x:Name="ClearShortcut" Tag="Clear" IsReadOnly="True" PreviewKeyDown="ShortcutKeyDown"
                   PreviewMouseDown="ShortcutMouseDown" GotKeyboardFocus="ShortcutFocused" LostKeyboardFocus="ShortcutUnfocused"/>
          <TextBlock x:Name="HotkeyStatus" TextWrapping="Wrap" Focusable="True" Margin="0,12,0,0"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="{local:Ui Application}" Tag="&#xE713;">
        <StackPanel Margin="28,24">
          <TextBlock Text="{local:Ui StartupAndAppearance}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>
          <CheckBox x:Name="StartWithWindows" Content="{local:Ui StartWithWindows}"/>
          <CheckBox x:Name="StartMinimized" Content="{local:Ui StartMinimized}" Margin="0,8,0,0"/>
          <CheckBox x:Name="MinimizeToTray" Content="{local:Ui MinimizeToNotificationArea}" Margin="0,8,0,0"/>
          <TextBlock Text="{local:Ui AppTheme}" Margin="0,16,0,8" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="AppThemeChoice" HorizontalAlignment="Left" Width="240">
            <ComboBoxItem Content="{local:Ui UseWindowsTheme}"/>
            <ComboBoxItem Content="{local:Ui Light}"/>
            <ComboBoxItem Content="{local:Ui Dark}"/>
          </ComboBox>
          <TextBlock Text="{local:Ui InterfaceLanguage}" Margin="0,16,0,8" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="LanguageChoice" HorizontalAlignment="Left" Width="240">
            <ComboBoxItem Content="Русский"/>
            <ComboBoxItem Content="English"/>
          </ComboBox>
          <Button Content="{local:Ui ResetAllSettings}" Click="ResetSettingsClicked" HorizontalAlignment="Left" Margin="0,16,0,0"/>
          <TextBlock x:Name="VersionLabel" Margin="0,12,0,0" Foreground="{DynamicResource FluentSecondary}"/>
          <TextBlock x:Name="AppStatus" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
