<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>APEX Chatd</AssemblyName>
    <RootNamespace>TwitchChatAgent</RootNamespace>
    <Product>APEX ChatD</Product>
    <Title>APEX ChatD</Title>
    <Version>1.20.12</Version>
    <ApplicationIcon>Assets/APEXChatd.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <PluginApprovalPublicKey Condition="'$(PluginApprovalPublicKey)' == ''">$(MSBuildProjectDirectory)/Assets/plugin-approval-public.pem</PluginApprovalPublicKey>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/APEXChatd.ico" />
    <Resource Include="Assets/APEXChatd.png" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <ProjectReference Include="Vendor/ScreenReader.Speech/ScreenReader.Speech.csproj" />
    <ProjectReference Include="PluginSdk/Chatd.PluginSdk.csproj" />
    <Compile Remove="Vendor/**;WebEffects/**;PluginSdk/**;Plugins/**" />
    <Page Remove="PluginSdk/**;Plugins/**" />
    <EmbeddedResource Include="$(PluginApprovalPublicKey)" LogicalName="PluginApprovalKey.pem" />
    <EmbeddedResource Include="Assets/obs-effects.js" LogicalName="obs-effects.js" />
  </ItemGroup>
</Project>





