<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>APEX Chatd</AssemblyName>
    <RootNamespace>TwitchChatAgent</RootNamespace>
    <Product>APEX Chatd</Product>
    <Title>APEX Chatd</Title>
    <Version>1.12.0</Version>
    <ApplicationIcon>Assets/APEXChatd.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/APEXChatd.ico" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <ProjectReference Include="Vendor/ScreenReader.Edge/ScreenReader.Edge.csproj" />
    <Compile Remove="Vendor/**;WebEffects/**" />
    <EmbeddedResource Include="Assets/obs-effects.js" LogicalName="obs-effects.js" />
  </ItemGroup>
</Project>





